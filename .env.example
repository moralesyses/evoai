# Settings for members' .com domains (includes/domains.php) and the Maya keys.
# Copy this file to .env in the same folder and fill it in. Setup and testing:
# README-API.md.
#
# Never commit or share .env: it holds API keys. The web server never serves
# it (.htaccess denies every dotfile). Lines are KEY=value; # starts a comment.

# --- Drivers ----------------------------------------------------------------
# Which registrar registers domains:
#   mock          offline test registrar, no account or internet needed (default)
#   resellerclub  ResellerClub HTTP API (test or live, see RESELLERCLUB_ENV)
REGISTRAR_DRIVER=mock

# How members pay (Maya is the only way to pay on this site):
#   maya  Maya Checkout (sandbox or production, see MAYA_ENV) (default)
#   mock  testing only: a local page with Pay now / Fail / Cancel buttons, nobody is charged
# Real payments and real domains go together: Maya production only with ResellerClub's
# live account; test payments only with the mock registrar or ResellerClub's test account.
# Any other mix refuses domain purchases.
PAYMENT_DRIVER=maya

# --- Maya Checkout ----------------------------------------------------------
# sandbox (pg-sandbox.paymaya.com, test cards) or production (pg.paymaya.com, real money).
MAYA_ENV=sandbox
# API keys from Maya Business Manager (sandbox keys for sandbox). When set, they
# replace the maya keys in config/config.php, which the membership checkout
# uses too. Public key: creates checkouts. Secret key: confirms payments.
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=

# --- ResellerClub -----------------------------------------------------------
# Reseller ID and API key: ResellerClub control panel > Settings > API.
# The server's public IP must be whitelisted there, and the reseller account
# needs prepaid funds: every registration and renewal is paid from them.
RESELLERCLUB_ID=
RESELLERCLUB_API_KEY=
# test (test.httpapi.com, the demo/test account) or live (httpapi.com, real domains).
RESELLERCLUB_ENV=test
# Seconds per request (default 30). Network errors are retried twice.
RESELLERCLUB_TIMEOUT=30
# Name servers for new domains, comma-separated. Empty: the customer's default
# ResellerClub name servers (needed for the A record to work).
DOMAIN_NAMESERVERS=
# true: buy privacy protection with every domain (charged by ResellerClub).
DOMAIN_PRIVACY=false

# --- Domains ----------------------------------------------------------------
# Public IPv4 address of this web server: each new domain gets A records
# (domain and www) pointing here, so it opens the member's digital card.
SERVER_IP=
# How the price members pay per year is set (Maya charges the price shown):
#   market  today's .com market price: Porkbun's public .com price (USD) times
#           today's USD->PHP rate, rounded up to the peso, refreshed daily (default)
#   fixed   DOMAIN_RETAIL_PRICE, and DOMAIN_RENEWAL_PRICE for renewals
DOMAIN_PRICE_SOURCE=market
# market: percentage added on top (your margin). Make sure the price covers
# what ResellerClub charges you for a .com.
DOMAIN_MARKUP_PERCENT=0
# market: never charge less than this many pesos. Empty: no minimum.
DOMAIN_MIN_PRICE=
# Price per year in pesos with DOMAIN_PRICE_SOURCE=fixed, and the fallback
# when the market price can't be fetched.
DOMAIN_RETAIL_PRICE=899
# fixed: renewal price per year; empty = DOMAIN_RETAIL_PRICE.
DOMAIN_RENEWAL_PRICE=
# Check every name with the .com registry (RDAP at Verisign) before offering
# or selling it: on (default) or off. Taken names are never offered.
DOMAIN_RDAP=on
# How cards link to members' own domains: http (works everywhere) or https
# (only once this server has an SSL certificate for every member's domain).
DOMAIN_URL_SCHEME=http

# --- GoDaddy (optional): domain market value -------------------------------
# With a GoDaddy API key, each new name is priced at its own market value
# (GoDaddy GoValue estimate in pesos), never below the registration cost
# above; renewals stay at the registration cost. The daily price check also
# compares GoDaddy's .com price with Porkbun's. Create one at developer.godaddy.com: a Personal Access
# Token, or an API key + secret (both work). Read-only calls only.
GODADDY_TOKEN=
GODADDY_API_KEY=
GODADDY_API_SECRET=
# production (api.godaddy.com) or ote (GoDaddy's test environment)
GODADDY_ENV=production
# GoValue appraisals per day at most (GoDaddy's own limit applies when lower).
GODADDY_DAILY_LIMIT=500
# off: no appraisals even with keys, so every name costs the registration cost.
DOMAIN_APPRAISAL=on

# --- Local testing only: leave empty --------------------------------------
# Send Maya / ResellerClub / registry / price calls to a fake server on this machine.
MAYA_BASE_URL=
RESELLERCLUB_BASE_URL=
RDAP_BASE_URL=
DOMAIN_PRICE_URL=
DOMAIN_FX_URLS=
GODADDY_BASE_URL=
